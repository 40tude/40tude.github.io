#!/bin/bash
# Updates last_modified_date in staged .md files before commit.
# Only the front matter is touched (block between the "---" on line 1
# and the next "---"), so examples inside code blocks stay as written.
# Files without front matter are left alone. CRLF files are matched too
# (Git for Windows sed may write them back as LF, Git normalizes anyway).

now=$(date +"%Y-%m-%d %H:%M:%S")

# Read one path per line so names with spaces stay whole.
# core.quotePath=false keeps non-ASCII names (accents) unquoted.
git -c core.quotePath=false diff --cached --name-only --diff-filter=ACMR \
  | grep '\.md$' | grep -v '^index\.md$' \
  | while IFS= read -r file; do
  if [ -f "$file" ] && head -n 1 "$file" | grep -qE '^---[[:space:]]*$'; then
    sed -i "1,/^---\r\?$/ s/^last_modified_date:[^\r]*/last_modified_date: $now/" "$file"
    git add "$file"
  fi
done
